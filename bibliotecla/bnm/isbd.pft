 proc(,@puntua.pft,),



if p(v100) then
  v100^a, " "v100^c,
fi,
if p(v110) then
  replace(replace(v110*4,s('^9',v110^9),'.'),'^b',' '),
fi,
if p(v111) then
  replace(replace(replace(replace(v111*4,'^n',' '),'^d',' '),'^c',' '),'^9',' '),
fi,
if p(v240) and a(v130) then
   /,'  [', v240^a, ']',
fi,
if p(v130) then
  '[', replace(v130*4,'^p',' '), ']',
fi,


/#,'  ', replace(replace(replace(v245*4,'^n',' '),'^b',' '),'^c',' '),




if p(v250) then ' -- ', v250^a, fi,



if p(v260) then ' -- ',
  replace(replace(replace(replace(replace(replace(
    v260*4,'^a',' '),'^b',' '),'^c',' '),'^e',' '),'^f',' '),'^g',' '),

fi,



if p(v300) then
   if v999*1.1='m' then /,'  ' else ' -- ', fi,
   replace(replace(v300*4,'^b',' '),'^e',' '),
fi,



if p(v440) then ' --',
  ,(,
      ' (', v440^a,
       if p(v440^p) then ' 'v440^p fi,
       if p(v440^v) then ' 'v440^v fi, ')',
  ,),
fi,

if v999*1.1='m' then /#, fi,


if v999*1.1='a' AND s(v500)>'' then ' --', fi,

if p(v500) then ' ',
  ,(,
     /* if NOT v500:'ibliogr' AND NOT v500:'onaci¢n' then ' ',v500^a, fi, */
     ' ',v500^a,
  ,),
fi, 



if v999*1.1='a' then
 /,'  En: ', ref(['MARC']val(v901),
             proc(,@puntua.pft,),
             replace(replace(replace(v245*4,'^n',' '),'^b',' '),'^c',' '),
             if p(v250) then ' -- ', v250^a, fi,
             if p(v260) then ' -- ',
               replace(replace(replace(replace(v260*4,'^a',' '),'^b',' '),'^c',' '),'^f',' '),
             fi,
      ),            
fi,



if p(v020) AND v999*1.1='m' then /,'  ISBN ',v020^a, fi,


if s(v650,v600,v610)>'' then
  proc(
       if p(v650) then ('a5555%',v650^a,v650^9,'%'), fi,
       if p(v600) then ('a5555%',v600^a,'%'), fi,
       if p(v610) then ('a5555%',v610^a,'%'), fi,
      ),
  ,(,
     if iocc>nocc(v5555) then break, else '  ',f(iocc,1,0),'. ',v5555, fi,
  ,),
  proc('d5555'),
fi,


if s(v700,v710,v711) > '' then
  proc(
       if p(v700) then ('a5555%',v700^a," "v700^c,'%'), fi,
       if p(v710) then ('a5555%',replace(replace(v710*4,'^b',' '), s('^9',v710^9),'.'),'%'), fi,
       if p(v711) then ('a5555%',v711^a,'%'), fi,
      ),
  proc('a5556%I%a5556%II%a5556%III%a5556%IV%a5556%V%',
       'a5556%VI%a5556%VII%a5556%VIII%a5556%IX%a5556%X%',
       'a5556%XI%a5556%XII%a5556%XIII%a5556%XIV%a5556%XV%',
       'a5556%XVI%a5556%XVII%a5556%XVIII%a5556%XIX%a5556%XX%',
      ),
  ,(,
     if iocc>nocc(v5555) then break else
       '  ',v5556,'. ',
       if right(v5555,2)='.,' then mid(v5555,1,size(v5555)-1),
         else if right(v5555,1)=',' then mid(v5555,1,size(v5555)-1),'.',
         else v5555,
       fi,fi,
     fi,
  ,),
  proc('d5555','d5556'),
fi,

if p(v859) then /#, v859^b[1], fi,

/#


/* ------------------------------------------------------------------ 
 *  Programa para la migraci¢n de la base BINAM desde CEPAL a MARC21                   
 *                                                                 
 *  Modo de empleo:  mx binam proc=@cepal2marc.proc                   
 *                                                                 
 * ------------------------------------------------------------------ 
 *  Biblioteca Nacional de Maestros - Abril/Noviembre de 2001                
 * ------------------------------------------------------------------
 *                                                                 
 * ------------------------------------------------------------------ 
 *  Los campos con etiquetas anteriores al 100 se generan al       
 *  final, para que est‚n disponibles los campos originales de     
 *  BINAM mientras se generan los otros campos de MARC            
 * ------------------------------------------------------------------
 */


/*  IMPORTANTE: correr el mxf0 y estudiar campos "raros" 
 *
 */

/* eliminar todos los campos */
'd*' 

/* etiquetas que se reutilizan */
'd01','d05','d20','d40','d80','d100','d610',

/* =============================================================== 
 * Campo 100 (CEPAL v10[1], v16[1])                                                         
 * Autor personal                                                  
 *
 * Corregir manualmente (luego de migrar): Papas, Santos, Abates,
 *  Kirk-Greene (al v700)
 *
 * Ver el caso de 3 funciones (aa, bb y cc). Puntuacion entre ocurencias
 *  del ^e ??
 * ===============================================================
 */

/****************** MONOGRAFICAS *****************/
if p(v16) and a(v10) then
  'a100#',
  /* ind1 */    if v16[1]:',' then '1' else '0',fi,
  /* ind2 */    ' ',
                if v16[1]:',' and mid(v16[1],instr(v16[1],',')+2, size(v16[1])):','
  /* autor */     then '^a',mid(
                                v16^*[1], 1, instr(v16^*[1],',') + instr(mid(v16^*[1],instr(v16^*[1],',')+1,size(v16^*[1])),',') - 1
                               ),
  /* titulo */         '^c',mid(mid(v16[1],instr(v16[1],',')+2,size(v16[1])), instr(mid(v16[1],instr(v16[1],',')+2,size(v16[1])),',')+2,size(mid(v16[1],instr(v16[1],',')+2,size(v16[1])))),
  /* autor */     else '^a',v16^*[1],
                fi,
  /* rol/es */  if p(v16^f[1])           /* testear con MFN 75000 */
                  then
                    if v16^f[1]:' y ' then
                      if v16^f[1]:', ' then
                         proc('a5000#',mid(v16^f[1],1,instr(v16^f[1],' y ')-1),'#'),
                      else
                      fi,
                      proc('a5000#',mid(v16^f[1],instr(v16^f[1],' y ')+3,1000),'#'),
                    else
                      proc('a5000#',v16^f[1],'#'),
                    fi,
                   ,(,
                      '^e',ref(['ROLES']l(['ROLES']v5000),v2),
                   ,),
                    proc('d5000'),
                fi,
  '#',
fi,

/****************** ANALITICAS *****************/
if p(v10) then
  'a100#',
  /* ind1 */    if v10[1]:',' then '1' else '0',fi,
  /* ind2 */    ' ',
                if v10[1]:',' and mid(v10[1],instr(v10[1],',')+2, size(v10[1])):','
  /* autor */     then '^a',mid(
                                v10^*[1], 1, instr(v10^*[1],',') + instr(mid(v10^*[1],instr(v10^*[1],',')+1,size(v10^*[1])),',') - 1
                               ),
  /* titulo */         '^c',mid(mid(v10[1],instr(v10[1],',')+2,size(v10[1])), instr(mid(v10[1],instr(v10[1],',')+2,size(v10[1])),',')+2,size(mid(v10[1],instr(v10[1],',')+2,size(v10[1])))),
  /* autor */     else '^a',v10^*[1],
                fi,
  /* rol/es */  if p(v10^f[1])
                  then
                    if v10^f[1]:' y ' then
                      proc('a5000#',mid(v10^f[1],1,instr(v10^f[1],' y ')-1),'#'),
                      proc('a5000#',mid(v10^f[1],instr(v10^f[1],' y ')+3,1000),'#'),
                    else
                      proc('a5000#',v10^f[1],'#'),
                    fi,
                   ,(,
                      '^e',ref(['ROLES']l(['ROLES']v5000),v2),
                   ,),
                    proc('d5000'),
                fi,
  '#',
fi,

/* =============================================================== 
 * Campo 110 (CEPAL v11[1], v17[1])                                
 * Autor institucional                                             
 *                                                                 
 * Actualizar la base JURISD al momento de la migracion            
 *
 * Titulos uniformes: usar la base UNIFORME, ignorando plurales, acentos,
 *  mayusculas.
 * ===============================================================
 */

/****************** MONOGRAFICAS *****************/
if p(v17) and a(v11) then
 'a110#',
 /* ind1 */    if v17[1]:'. ' and l(['JURISD']mid(v17[1],1,instr(v17[1],'. ')))<>0
                 then '1',
                 else '2',
              ,fi,
 /* ind2 */    ' ',
 /* Autor */   if v17[1]:'. '
                 then
                  '^a',mid(v17[1],1,instr(v17[1],'. ')-1),
                  replace(mid(v17^*[1],instr(v17^*[1],'. '),size(v17[1])),'. ','.^b'),
                ,else
                  '^a',v17[1],
              ,fi
 '#',
fi,

/**************** ANALITICAS ***************/
if p(v11) then
 'a110#',
 /* ind1 */    if v11[1]:'. ' and l(['JURISD']mid(v11[1],1,instr(v11[1],'. ')))<>0
                 then '1',
                 else '2',
              ,fi,
 /* ind2 */    ' ',
 /* Autor */   if v11[1]:'. '
                 then
                  '^a',mid(v11[1],1,instr(v11[1],'. ')-1),
                  replace(mid(v11^*[1],instr(v11^*[1],'. '),size(v11[1])),'. ','.^b'),
                ,else
                  '^a',v11[1],
              ,fi
 '#',
fi,


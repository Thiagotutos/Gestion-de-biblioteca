/* ===============================================================
 * Campo 700 (CEPAL v10, v16)
 * Autores secundarios
 * 
 * testear con
 *  mx binam from=102000 proc=@bnmmarc.proc
 *  "pft='MFN: 'mfn/'-----'/(v16/)#(v100/)#(v700/)'---------------------'/"
 *  proc='d700/1'
 * ===============================================================
 */

if nocc(v16)>1 then
  ( if v16<>v16[1] then,
   'a700#',
   /* ind1 */    if v16:',' then '1' else '0' fi,
   /* ind2 */    ' ',
   /* autor */   '^a',v16^*,  /* excluir lo que sigue a la 2da. coma */
   /* titulo */  if v16^*:',' and mid(v16^*,instr(v16^*,',')+2,size(v16^*)):','
                   then '^c',mid(mid(v16^*,instr(v16^*,',')+2,size(v16^*)), instr(mid(v16^*,instr(v16^*,',')+2,size(v16^*)),',')+2,size(mid(v16^*,instr(v16^*,',')+2,size(v16^*)))) ,fi,
   /* rol */     if p(v16^f) then '^e',ref(['ROLES']l(['ROLES']v16^f),v2) fi,
   '#',fi,
  )
,fi,



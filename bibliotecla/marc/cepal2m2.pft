/* =============================================================== 
 * Campo 240 (CEPAL v17)                                           
 * T¡tulo uniforme                                                 
 *
 * Duda: 240 vs. 130
 *
 * Separar jurisdicciones para mandar al v110
 *
 * No entiendo lo que estoy haciendo...
 * ===============================================================
 */

/*
if l(['JURISD']mid(v17^*[1],1,instr('. ')-1)) <> 0
   and
   mid(v17^*[1],instr('. ')+2,1) = '['
then
  'a240#',
      '0',
      '0',
    '^a', mid(v17^*[1],instr(v17^*[1],'[')+1,size(v17^*[1])),
  '#',
fi
*/

/*
,(,
   if v17:'[' then
     'a240#','0','0','^a',v17,'#',
   fi,
,),
*/

if v17^*:'['
   and
   l(['UNIFORME']mid(v17^*,instr(v17^*,'[')+1,instr(v17^*,']')-1))<>0
then
  'a240#','0','0','^a',v17^*,'#',
fi,


/* =============================================================== 
 * Campo 245 (CEPAL v10, v11, v12, v16, v17, v18)                  
 * T¡tulo y menci¢n de responsabilidad                             
 *
 *      como aparecen los signos ':' y '=' en v18 [v18-2pt.txt]
 *
 *      numeros que van a ^n  ??? (buscar '. nnn' al final o antes
 *         de ':'                                                  
 *
 *      que se hace cuando v18 se repite? Mandar la primera occ. al
 *         ^a, todo el resto al ^b (separando occs. con ' ; ')     
 *
 *      agregar ... [et al.]  (tener en cuenta funciones)
 *
 *      autor institucional (v17)
 *
 *      que se hace con v16^f? Ver AACR2: se convierte desde ROLES
 *
 *      que hacemos con el v18 y sus techitos? Lo arregla Laura [listo]
 *
 *      ^n, ^p:
 *      Ej: En busca del tiempo perdido. 5: la prisionera --> ^n5^pla prisionera
 *       Buscar: 
 *      /[Tomo|Tome|T[.|:]|Parte|Part|P[.|:]|Volumen|Vol|V[.|:]|Secci[o|¢]n|Section] ?[\d|I|V|X|L|C]/i
 *
 *      Candidatos al v111: 
 *      /[conf.r.nc|sal.n|congr.s|jornada|reuni.n|simposio|encuentro|taller|workshop|]/
 *
 *      Verificar valores actuales de ^f en BINAM (ver Diccionario) para convertir
 *       los roles cuando hay m s de uno para la misma persona (lo mir¢ Laura)
 *
 * ===============================================================
 */

'a245#',
/* ind1 */  '0',
/* ind2 */  '0',
            '^a',
            if v18:': '
              then if v18:'. ' and l(['DIGITOS']mid(v18,instr(v18,'. ')+2,1))<>0
                     then replace(mid(v18,1,instr(v18,'. ')-1),': ','^b')
                     else replace(v18,': ',' :^b'),
                  ,fi,   
              else if v18:'= '
                     then if v18:'. ' and l(['DIGITOS']mid(v18,instr(v18,'. ')+2,1))<>0
                            then replace(mid(v18,1,instr(v18,'. ')-1),'= ','^b'),
                            else replace(v18,'= ',' =^b'),
                         ,fi,
                     else if v18:'. ' and l(['DIGITOS']mid(v18,instr(v18,'. ')+2,1))<>0
                            then mid(v18,1,instr(v18,'. ')-1),
                            else v18,
                         ,fi,
                  ,fi,
            fi,

            /* numero de una parte */
            if v18:'. ' and l(['DIGITOS']mid(v18,instr(v18,'. ')+2,1))<>0
              then '^n', mid(v18, instr(v18,'. ')+2, size(v18)),
            fi,

            if p(v16) or p(v17) then ' /^c' ,fi

            if p(v16)
              then (
                    if iocc>1
                      then ', ',
                    fi,
                    if v16^*:', '
                      then mid(v16^*,instr(v16^*,', ')+2,size(v16^*)),
                           ' ',
                           mid(v16^*,1,instr(v16^*,', ')-1),
                     ,else v16^*,
                    fi,
                    /*
                    if p(v16^f)
                      then ', ', ref(['ROLES']l(['ROLES']v16^f),v2),
                    fi,
                    */
                   ),
            fi,

            if p(v17) and a(v16)
              then (
                    if iocc>1
                      then ', ',
                    fi,
                    v17^*,
                   ),
           ,fi,
'#',

/* =============================================================== 
 * Campo 250 (CEPAL v41)
 * Edici¢n
 * ===============================================================
 */

if p(v41) then
  'a250#',
   ' ',
   ' ',
   '^a',v41,
  '#',
fi,

/* =============================================================== 
 * Campo 260 (CEPAL v39, v38, v43)
 * Lugar, editor y fecha
 *
 * ===============================================================
 */

if p(v39) or p(v38) or p(v43) then
  'a260#',
  ' ',
  ' ',
  if p(v39)
    then
      if nocc(v39)=1 or nocc(v38) > 1 then |^a|v39,  /* quedan todas */
      else
        /* Varios lugares & una editorial: */
        /*  Si Bs. As. es la 1ra occ --> queda s¢lo Bs.As. */
        /*  Si Bs. As. est  en otra occ --> queda la 1ra + Bs. As. y nada m s */
        /*  Si Bs. As. est  ausente --> queda s¢lo la 1ra. */
    
        /*  Normalizar primero la ortograf¡a! Ver archivo bsas.txt y bsas2.txt */

        if not v39:'Buenos Aires' or v39[1]:'Buenos Aires' then '^a',v39[1]
        else                   /* testear con MFN 9995 */
          '^a',v39[1],
          ,(,
            if v39:'Buenos Aires' then '^a',v39, break, fi
          ,),
        fi,
      fi,
  fi,
  if p(v38)
    then |^b|v38,
  fi,
  if p(v43) then '^c',v43 fi,
  '#',
fi,

